# Existing public Apps Script endpoints used by the form popups. Do not commit .env.local.
# BOOKING_ENDPOINT may be set as a server-only replacement; the legacy public
# variable remains supported so the working deployment does not change.
BOOKING_ENDPOINT=
NEXT_PUBLIC_LEAD_ENDPOINT=
NEXT_PUBLIC_BOOKING_ENDPOINT=

# Messaging is disabled unless this is set to the literal value true.
MESSAGING_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID_RECEIVED=
TWILIO_CONTENT_SID_CONFIRMED=

# Shared only between the Cloudflare Worker and the installed Apps Script trigger.
BOOKING_APPROVAL_WEBHOOK_SECRET=
# Optional, authenticated callback to mirror receipt channel outcomes to Sheets.
BOOKING_NOTIFICATION_RESULT_WEBHOOK_URL=
